{
  "name": "vareliox",
  "private": true,
  "version": "0.1.11",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:translations && tsc && vite build",
    "test:conversations": "node --test --experimental-strip-types tests/conversations.test.ts",
    "test:intents": "node --test --experimental-strip-types tests/actionIntent.test.ts",
    "test:actions": "node --test --experimental-strip-types tests/actionProtocol.test.ts",
    "test:targets": "node --test --experimental-strip-types tests/actionTargets.test.ts",
    "test:projects": "node --test --experimental-strip-types tests/projects.test.ts",
    "test:terminal": "node --test --experimental-strip-types tests/terminalAgent.test.ts",
    "test:media": "node --test --experimental-strip-types tests/mediaIntent.test.ts",
    "test:providers": "node --test --experimental-strip-types tests/providerCapabilities.test.ts",
    "test:translations": "node --test --experimental-strip-types tests/translations.test.ts",
    "test:secrets": "node scripts/check-secrets.mjs",
    "test:agent:local": "node scripts/smoke-agent-ollama.mjs",
    "test:frontend": "npm run test:translations && npm run test:intents && npm run test:actions && npm run test:targets && npm run test:conversations && npm run test:projects && npm run test:terminal && npm run test:media && npm run test:providers && npm run test:secrets",
    "test:all": "npm run test:frontend && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run test:all && npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "preview": "vite preview",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:macos": "tauri build --bundles app,dmg --target universal-apple-darwin",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-icons/devicon": "^1.2.17",
    "@iconify/react": "^6.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
